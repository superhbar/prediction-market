{
  "name": "prediction-market",
  "description": "Oracle-settled prediction markets on Hedera: HTS position tokens, HIP-1215 self-scheduled settlement on Chainlink, optional Pyth fallback.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": [
        "nextjs-app"
      ],
      "solidityFramework": [
        "foundry"
      ],
      "packageManager": [
        "yarn",
        "npm"
      ]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Generate or import a deployer account",
              "command": "{run:framework:account:generate}"
            },
            {
              "label": "Start a local chain",
              "command": "{run:framework:chain}"
            },
            {
              "label": "Deploy contracts to that node",
              "command": "{run:framework:deploy} --network localhost"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "text": "For Hedera testnet/mainnet deploy and verify, see the Scaffold HBAR docs and your chosen package README under packages/hardhat or packages/foundry."
            }
          ]
        }
      ]
    }
  }
}
