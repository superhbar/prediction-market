NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
# Optional, server-only: enables the "Settle with Pyth" fallback via /api/pyth.
# Never prefix with NEXT_PUBLIC_; the key must not reach the browser.
PYTH_API_KEY=
# Optional: override the Pyth Hermes endpoint (default https://hermes.pyth.network).
PYTH_HERMES_URL=
# Optional: HCS topic for public settlement records (node scripts/createRecordTopic.mjs creates one).
HCS_RECORD_TOPIC_ID=
# Optional, server-only: the account that pays for publishing records, and its key (hex ECDSA or DER).
# Never prefix with NEXT_PUBLIC_.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
